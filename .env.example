# Образец переменных окружения. Реальные значения сюда НЕ вписывать:
# на хостинге они задаются в панели, локально — в файле .env рядом с ботом.

# Токен бота MAX. Выдаёт @MasterBot по команде /newbot.
MAX_BOT_TOKEN=

# Где бот хранит состояние: шаги диалогов, гостей и очередь напоминаний.
# На хостинге путь должен вести в папку, которая переживает перезапуск.
MAX_STATE_FILE=/app/data/max_bot_state.json

# YCLIENTS
YCLIENTS_TOKEN=
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=

# Менеджер: имя и телефон показываются гостю текстом,
# MANAGER_MAX_URL — ссылка для кнопки «Написать менеджеру».
MANAGER_NAME=
MANAGER_CONTACT_URL=
MANAGER_MAX_URL=

# Сотрудники YCLIENTS, на которых заведены бани
BIRCH_STAFF_ID=
PINE_STAFF_ID=

# Услуги: баня x тип дня x с процедурами / без
BIRCH_WEEKDAY_NO_PROC_SERVICE_ID=
BIRCH_WEEKDAY_WITH_PROC_SERVICE_ID=
BIRCH_WEEKEND_NO_PROC_SERVICE_ID=
BIRCH_WEEKEND_WITH_PROC_SERVICE_ID=
PINE_WEEKDAY_NO_PROC_SERVICE_ID=
PINE_WEEKDAY_WITH_PROC_SERVICE_ID=
PINE_WEEKEND_NO_PROC_SERVICE_ID=
PINE_WEEKEND_WITH_PROC_SERVICE_ID=

# Категория YCLIENTS с процедурами банного меню
PROCEDURES_CATEGORY_ID=26014494

# Часовой пояс филиала: сервер может стоять в другой зоне
TIMEZONE=Europe/Moscow
